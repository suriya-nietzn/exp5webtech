<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NovaApp - Timer and Arrays</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f1ff;
    color: white;
}

/* Navigation */
.navbar {
    background: #24105c;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

.nav-links {
    display: flex;
    gap: 25px;
    list-style: none;
}

.nav-links a {
    color: white;
    text-decoration: none;
}

/* Hero Section */
.hero {
    background: linear-gradient(135deg, #24105c, #7539e8);
    padding: 80px 20px;
    text-align: center;
}

.hero h1 {
    font-size: 40px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 18px;
    margin-bottom: 20px;
}

button {
    background: #a875ff;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 20px;
    cursor: pointer;
}

/* Features */
.features {
    color: #24105c;
    text-align: center;
    padding: 40px 20px;
}

.feature-box {
    display: inline-block;
    background: white;
    padding: 25px;
    margin: 10px;
    width: 200px;
    border-radius: 12px;
    box-shadow: 0 3px 10px #0002;
}

/* Offer Section */
.offer {
    background: linear-gradient(135deg, #5122ad, #a875ff);
    text-align: center;
    padding: 40px 20px;
}

.offer h2 {
    margin-bottom: 15px;
}

.countdown {
    font-size: 30px;
    font-weight: bold;
    margin-top: 20px;
}

@media(max-width: 600px) {
    .navbar {
        flex-direction: column;
        gap: 15px;
    }

    .nav-links {
        gap: 12px;
    }

    .hero h1 {
        font-size: 30px;
    }
}
</style>
</head>

<body>

<!-- Navigation Bar -->
<nav class="navbar">
    <div class="logo">NovaApp</div>

    <ul class="nav-links">
        <li><a href="#home">Home</a></li>
        <li><a href="#features">Features</a></li>
        <li><a href="#about">About</a></li>
    </ul>

    <button onclick="downloadApp()">Download</button>
</nav>

<!-- Home Section -->
<section class="hero" id="home">
    <h1>Smarter App. A Better You.</h1>

    <p>Boost productivity and achieve more!</p>

    <button onclick="downloadApp()">Download Now</button>
</section>

<!-- Features Section -->
<section class="features" id="features">
    <h1>Our Features</h1>

    <div id="featureList"></div>
</section>

<!-- Offer Section -->
<section class="offer" id="about">

    <h2 id="offerText">Special Offer!</h2>

    <p>Get 50% OFF on NovaApp Premium Plan</p>

    <h3>Offer Ends In:</h3>

    <div class="countdown" id="timer">
        00:00:00
    </div>

</section>

<script>

// 1. JavaScript Array
const features = [
    "Fast and Simple",
    "Track Progress",
    "Secure and Reliable",
    "Easy to Use"
];

// Display Array Elements
let output = "";

for (let i = 0; i < features.length; i++) {
    output += `<div class="feature-box">
                <h3>${features[i]}</h3>
               </div>`;
}

document.getElementById("featureList").innerHTML = output;


// 2. setTimeout() Function
setTimeout(function() {
    alert("Welcome to NovaApp!");
}, 2000);


// 3. setInterval() Function
let seconds = 60 * 60;

let timer = setInterval(function() {

    let hours = Math.floor(seconds / 3600);
    let minutes = Math.floor((seconds % 3600) / 60);
    let secs = seconds % 60;

    document.getElementById("timer").textContent =
        String(hours).padStart(2, "0") + ":" +
        String(minutes).padStart(2, "0") + ":" +
        String(secs).padStart(2, "0");

    seconds--;

    // 4. clearInterval() Function
    if (seconds < 0) {
        clearInterval(timer);
        document.getElementById("timer").textContent =
            "Offer Expired!";
    }

}, 1000);


// 5. Array with Rotating Messages
const offers = [
    "Special Offer!",
    "Limited Time!",
    "Don't Miss Out!"
];

let index = 0;

setInterval(function() {

    document.getElementById("offerText").textContent =
        offers[index];

    index = (index + 1) % offers.length;

}, 3000);


// Download Button
function downloadApp() {
    alert("Thank you for choosing NovaApp!");
}

</script>

</body>
</html>
